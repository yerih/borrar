      "name": "token cobro inmediato",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 1. Definir los datos para la solicitud del token\r",
              "const tokenUrl = 'https://portalapiqa.bancoplaza.com/oauth2/token';\r",
              "const clientId = 'N6nAqhrTrPd7rwjAazbeZ4EWpWMa';  //bordado qa\r",
              "const clientSecret = 'rtUIiwvA4SWSMH8anD2eUdREQ6Aa'; //bordado qa\r",
              "\r",
              "\r",
              "// WSO2 suele usar Basic Auth para el endpoint de token\r",
              "const base64Auth = btoa(clientId + \":\" + clientSecret);\r",
              "\r",
              "const requestOptions = {\r",
              "    url: tokenUrl,\r",
              "    method: 'POST',\r",
              "    header: {\r",
              "        'Authorization': 'Basic ' + base64Auth,\r",
              "        'Content-Type': 'application/x-www-form-urlencoded'\r",
              "    },\r",
              "    body: {\r",
              "        mode: 'urlencoded',\r",
              "        urlencoded: [\r",
              "            { key: 'grant_type', value: 'client_credentials' }\r",
              "        ]\r",
              "    }\r",
              "};\r",
              "\r",
              "// 2. Ejecutar la petición del token\r",
              "pm.sendRequest(requestOptions, (err, response) => {\r",
              "    if (err) {\r",
              "        console.log(\"Error obteniendo el token:\", err);\r",
              "    } else {\r",
              "        const jsonResponse = response.json();\r",
              "        const accessToken = jsonResponse.access_token;\r",
              "        \r",
              "        // 3. Guardar el token en una variable de colección\r",
              "        // \"current_token\" es el NOMBRE de la etiqueta en Postman\r",
              "        pm.collectionVariables.set(\"current_token\", accessToken);\r",
              "        \r",
              "        console.log(\"Token actualizado correctamente\");\r",
              "        \r",
              "        // CORRECCIÓN: Usamos accessToken que es la variable de JS\r",
              "        console.log(\"Token: \" + accessToken); \r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
